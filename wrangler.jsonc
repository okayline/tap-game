{
  "name": "tap-game",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // one Durable Object per match (SQLite-backed, which the free plan allows)
  "durable_objects": { "bindings": [{ "name": "MATCH", "class_name": "Game" }] },
  // v2 and v3 (kura, Nov 5): the class became Game and Match's namespace was deleted, with every match stored in it
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Match"] }, { "tag": "v2", "new_sqlite_classes": ["Game"] }, { "tag": "v3", "deleted_classes": ["Match"] }],
  // the shared item table's deal pool, for the buttons (dungeon-items' Registry entrypoint: dealPool)
  "services": [{ "binding": "REGISTRY", "service": "dungeon-items", "entrypoint": "Registry" }],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  // files in public/ (the fonts) are served as they are, before the Worker runs; public/_headers sets how long browsers keep them
  "assets": { "directory": "./public" }
}
