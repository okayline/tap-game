{
  "name": "tap-game",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // one Durable Object per match (SQLite-backed, which the free plan allows)
  "durable_objects": { "bindings": [{ "name": "MATCH", "class_name": "Match" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Match"] }],
  // the shared item table, for the buttons
  "services": [{ "binding": "ITEMS", "service": "dungeon-items" }],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }]
}
